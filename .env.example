# Porta do servidor
PORT=3000

# Usuário e senha do painel administrativo.
# Se ADMIN_PASSWORD não for definida, uma senha é sorteada e impressa
# no console na primeira execução.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Caminho do banco SQLite (padrão: ./data/lavrasfm.db)
# DB_PATH=./data/lavrasfm.db

# Em produção, atrás de um proxy (nginx, Caddy, Cloudflare, Render):
# NODE_ENV=production
# TRUST_PROXY é o NÚMERO DE PROXIES na frente da aplicação (1 no Render), ou
# uma lista de IPs/sub-redes. Não use "true": confiar em qualquer proxy deixa
# o IP do visitante ser forjado, e com ele o limite de tentativas de login.
# TRUST_PROXY=1

# Endereço público do site, usado nas prévias de compartilhamento e no sitemap.
# Sem isso, o site usa o endereço da própria requisição.
# SITE_URL=https://lavrasfm.com.br

# Teto de ouvintes simultâneos na retransmissão (padrão: 50).
# MAX_RELAY_LISTENERS=50

# Backups do banco: quantas cópias manter e de quantas em quantas horas.
# BACKUP_KEEP=7
# BACKUP_INTERVAL_HOURS=24

# Em produção, o banco, os backups e os logs devem ficar num disco que
# sobreviva aos deploys (no Render, o disco montado em /var/dados):
# DB_PATH=/var/dados/lavrasfm.db
# BACKUP_DIR=/var/dados/backups
# LOG_DIR=/var/dados/logs

# APENAS PARA TESTES. Desliga a proteção que impede o servidor de buscar
# endereços na rede interna (proteção contra SSRF). Nunca ligar em produção.
# PERMITIR_DESTINO_INTERNO=1
